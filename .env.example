GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
BUFFER_API_KEY=your_buffer_api_key
DATABASE_URL="file:./dev.db"
PORT=3000
TIMEZONE=Asia/Kolkata

# Optional: required only for Instagram scheduling. Buffer requires a public
# image URL for every Instagram post and has no upload endpoint, so the
# rendered post card is uploaded to Cloudinary for a stable URL. Without
# these, Instagram is skipped automatically and LinkedIn/Twitter still run.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: without this, the branded card falls back to the static line icon
# badge instead of an AI-generated hero image (see template.service.ts).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: text-generation alternative to Gemini, and this pipeline's
# primary live-news search (see services/groq.service.ts,
# services/news-research.service.ts).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: deterministic news-search fallback used if Groq's compound web
# search fails (see services/news-research.service.ts). Free tier at
# gnews.io covers this pipeline's cadence with headroom.
GNEWS_API_KEY=
